# Copy to .env; never commit real credentials.
# Current authenticated client: PLC point analysis. See MODEL_SERVICES.md.
SILICONFLOW_API_KEY=replace-with-your-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
CHAT_MODEL=Qwen/Qwen3.5-9B
POINT_ANALYSIS_MODEL=Qwen/Qwen3.5-9B
POINT_ANALYSIS_BATCH_SIZE=12
POINT_ANALYSIS_MAX_BUNDLE_CHARS=60000
# Client support exists; embeddings/reranking are not wired into diagnosis retrieval yet.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
MODEL_TIMEOUT=180
